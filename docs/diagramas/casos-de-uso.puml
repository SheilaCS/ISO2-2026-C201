@startuml Diagrama general de casos de uso - SESCAM Radiodiagnóstico

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

' ==== Actores humanos ====
actor "Paciente" as P
actor "Médico" as M
actor "Administrativo\n/ Admisión" as A
actor "Administrador\ndel Sistema" as Adm

' ==== Actores de sistema ====
actor "SSO corporativo" as SSO <<system>>
actor "HCE" as HCE <<system>>
actor "Admisión" as ADM <<system>>
actor "RIS/PACS" as RIS <<system>>
actor "Temporizador" as T <<system>>

rectangle "Sistema Integral de Gestión de Radiodiagnóstico e Imagen Médica" {

  ' --- Autenticación ---
  usecase "CU01 Iniciar sesión (SSO)" as CU01

  ' --- Paciente ---
  usecase "CU02 Gestionar mis citas" as CU02
  usecase "CU03 Notificaciones y recordatorios" as CU03
  usecase "CU04 Consultar historial de pruebas" as CU04
  usecase "CU05 Incidencias y encuestas" as CU05

  ' --- Médico ---
  usecase "CU06 Solicitar prueba diagnóstica" as CU06
  usecase "CU07 Prescribir seguimiento" as CU07
  usecase "CU08 Consultar estado de solicitudes" as CU08
  usecase "CU09 Crear y consultar informes" as CU09
  usecase "CU10 Registrar realización e incidencias" as CU10
  usecase "CU11 Estadísticas del médico" as CU11

  ' --- Administrativo ---
  usecase "CU12 Gestionar pacientes" as CU12
  usecase "CU13 Gestionar citas" as CU13
  usecase "CU14 Gestionar agendas médicas" as CU14
  usecase "CU15 Gestionar listas de espera" as CU15
  usecase "CU16 Informes operativos" as CU16

  ' --- Administrador ---
  usecase "CU17 Configurar parámetros" as CU17
  usecase "CU18 Gestionar roles y permisos" as CU18
  usecase "CU19 Auditoría de accesos" as CU19
  usecase "CU20 Configurar integraciones" as CU20
  usecase "CU21 Estadísticas globales" as CU21

}

' ==== Asociaciones actor - CU ====
P --> CU01
P --> CU02
P --> CU03
P --> CU04
P --> CU05

M --> CU01
M --> CU06
M --> CU07
M --> CU08
M --> CU09
M --> CU10
M --> CU11

A --> CU01
A --> CU12
A --> CU13
A --> CU14
A --> CU15
A --> CU16

Adm --> CU01
Adm --> CU17
Adm --> CU18
Adm --> CU19
Adm --> CU20
Adm --> CU21

' ==== Relaciones con actores de sistema ====
CU01 ..> SSO : <<include>>
CU04 ..> HCE : <<include>>
CU09 ..> RIS : <<include>>
CU12 ..> ADM : <<include>>
CU20 ..> SSO
CU20 ..> HCE
CU20 ..> ADM
CU20 ..> RIS
CU03 ..> T : <<extend>>
CU07 ..> T : <<extend>>

note bottom of M
  El Médico hereda las funcionalidades
  del Paciente que le apliquen
  (consulta de historial, notificaciones).
end note

@enduml